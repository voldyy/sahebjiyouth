# Enable Sheets API in this Google Cloud project and configure OAuth consent.
# Use a Web application client; authorize your exact website origin.
# Public client ID only. NEVER put a client secret or access token here.
VITE_GOOGLE_CLIENT_ID=
# Real Google Sheets roster is the default. Set true only for sample-data demos.
VITE_DEMO_MODE=false
# SQLite workspace API (this is also the application default).
VITE_WORKSPACE_API_URL=https://mandir-hospitality-api.usayouth.workers.dev/api
