{
  "name": "mandir-hospitality",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "build:backend": "node scripts/build-apps-script.mjs",
    "build:notifications": "node scripts/build-notifications.mjs",
    "preview:whatsapp": "node scripts/preview-yogi-prasad.mjs",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:database": "vitest run --config worker/vitest.config.js",
    "build:database": "wrangler deploy --config worker/wrangler.jsonc --dry-run --outdir ../worker-dist",
    "test:database-ui": "playwright test --config playwright.database.config.js",
    "test:sheets": "node scripts/build-apps-script.mjs && playwright test --config playwright.sheets.config.js",
    "test:form": "playwright test --config playwright.form.config.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.150.0"
  }
}
